<idea-plugin>
    <id>net.chikach.mergex</id>
    <name>Merge CLI Fixer</name>
    <vendor>chikach</vendor>

    <idea-version since-build="261"/>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <appStarter id="mergex" implementation="net.chikach.mergex.MergexStarter"/>
        <nonProjectFileWritingAccessExtension
            implementation="net.chikach.mergex.MergexFileAccessProvider"/>
    </extensions>
</idea-plugin>
